# Spring Boot Production Environment Variables
PORT=8080
DB_URL=jdbc:mysql://<host>:<port>/<dbname>?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=<username>
DB_PASS=<password>
JWT_SECRET=super-secure-production-jwt-secret-key-at-least-32-chars-long
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
